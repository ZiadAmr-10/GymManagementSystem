@model int?

<div class="container mt-5">

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card p-5 shadow text-center">

                <p class="fs-3 text-primary-color mb-4">
                    Are you sure you want to delete this Trainer?
                </p>

                <div class="alert alert-warning text-start" role="alert">
                    <strong>Warning!</strong>
                    This action cannot be undone. All Trainer data will be permanently deleted.
                </div>

                <form asp-action="DeleteConfirmed" method="post" class="mt-4">

                    <input type="hidden" name="Id" value="@Model" />

                    <div class="buttons d-flex justify-content-between gap-3">
                        <a asp-controller="Trainers" asp-action="Index" class="btn-outline flex-fill">
                            NO
                        </a>

                        <button type="submit" class="btn-fill flex-fill">
                            Yes
                        </button>
                    </div>

                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const alerts = document.querySelectorAll(".alert-danger");

            alerts.forEach(function(alert) {
                setTimeout(function() {
                    const bsAlert = bootstrap.Alert.getOrCreateInstance(alert);
                    bsAlert.close();
                }, 4000);
            });
        });
    </script>
}